# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Required when using a Udacity/Vocareum key (one starting with "voc-").
# Vocareum keys must be routed through the Vocareum proxy; sending one to
# OpenAI's default endpoint will fail authentication.
# Leave this blank to use OpenAI's default endpoint with a standard sk- key.
base_url=https://openai.vocareum.com/v1

# Optional: Model Configuration
MODEL_NAME=gpt-4o
TEMPERATURE=0.1

# Optional: Session Storage
SESSION_STORAGE_PATH=./sessions
