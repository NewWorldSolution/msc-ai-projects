# EcoHome Energy Advisor — environment template
# Copy to .env and fill in the values. .env is gitignored at the repo root.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# API key
# ---------------------------------------------------------------------------
# Your Udacity/Vocareum key. Starts with "voc-".
# Read by agent.py (the chat model) and tools.py (the embeddings model).
VOCAREUM_API_KEY=voc-your_key_here

# ---------------------------------------------------------------------------
# Endpoint
# ---------------------------------------------------------------------------
# Vocareum keys MUST be routed through the Vocareum proxy. Sending a voc- key
# to OpenAI's default endpoint fails authentication.
# If you ever swap in a personal sk- key, blank this line to use api.openai.com.
OPENAI_BASE_URL=https://openai.vocareum.com/v1

# Public Open-Meteo endpoints used by the weather tool.
GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
FORECAST_URL=https://api.open-meteo.com/v1/forecast

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Default chat model. agent.py's Agent(model=...) default is gpt-4o-mini;
# this variable is not read yet — wire it up if you want it configurable.
# MODEL_NAME=gpt-4o-mini

# A stronger model evaluates responses generated by the default chat model.
EVALUATOR_MODEL=gpt-4o
